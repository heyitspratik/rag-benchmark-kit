# Copy to .env and adjust. Never commit .env.
# The committed defaults run the whole stack locally at zero cost and with no signup.

# Application
APP_ENV=dev                  # dev | prod, controls structlog output format
LOG_LEVEL=INFO
API_KEY=                     # optional; when set, the HTTP API requires X-API-Key

# LLM provider
# ollama | anthropic | openai
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1024

# Ollama (default: no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Anthropic (only when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Services
POSTGRES_DSN=postgresql+psycopg://rag:rag@localhost:5432/rag_bench
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Model cache
HF_HOME=.cache/huggingface
